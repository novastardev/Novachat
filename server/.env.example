# Copy this file to .env in the same folder, then fill in your OAuth app credentials.
# Never commit server/.env or place OAuth secrets in frontend environment variables.
NOVASTACK_OAUTH_CLIENT_ID=your_registered_novastack_oauth_client_id
NOVASTACK_OAUTH_CLIENT_SECRET=your_registered_novastack_oauth_client_secret
NOVASTACK_OAUTH_ISSUER=https://api-novastack.vercel.app/api/auth
# Public URL of this Express server; must exactly match the OAuth app redirect URI base.
# Local development example (register http://localhost:3001/api/oauth/callback in NovaStack):
NOVACHAT_PUBLIC_URL=http://localhost:3001
# URL of the frontend; OAuth redirects back here after connection.
NOVACHAT_FRONTEND_URL=http://localhost:5173
# If the proxy is hosted separately, set VITE_PROXY_URL in the frontend build to its URL.

# Speech-to-text for voice messages (https://www.assemblyai.com/dashboard)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# Optional: EU data residency
# ASSEMBLYAI_BASE_URL=https://api.eu.assemblyai.com
# Optional: comma-separated model priority list (default: universal-3-pro,universal-2)
# ASSEMBLYAI_SPEECH_MODELS=universal-3-pro,universal-2
